# Default (placeholder) values for every secret the build expects.
#
# The Secrets Gradle plugin reads real values from `.env` and falls back to this
# file, generating a BuildConfig field and a manifest placeholder per key. Every
# key the app references must be declared here so a fresh checkout without a
# `.env` still compiles.
#
# Values must be non-empty — the plugin substitutes them verbatim into generated
# Java, and a blank value produces `String KEY = ;` which does not compile.
# The app treats any value starting with `MY_` as "not configured": the map
# renderer then falls back to keyless tile CDNs (Carto, OpenStreetMap), so the
# app works without real keys.

# Gemini AI. AI Studio injects the real value from user secrets at build time.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# TomTom map + traffic tiles. Placeholder -> keyless CDN fallback.
TOMTOM_API_KEY=MY_TOMTOM_API_KEY

# Google Maps platform key, read from the manifest meta-data.
MAPS_API_KEY=MY_MAPS_API_KEY

